# Core Service Settings
SECRET_KEY=replace-with-a-strong-random-secret
DEBUG=False

# Database Connection (Supabase / Managed Postgres)
# Use Transaction Mode (port 6543) for best compatibility with serverless/container workers
DB_HOST=replace-with-db-host
DB_PORT=6543
DB_NAME=postgres
DB_USER=replace-with-db-user
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# Redis & Cache
REDIS_URL=redis://redis:6379/0

# Allowed Hosts & URLs
ALLOWED_HOSTS=your-domain.com,api.your-domain.com,core
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Email (SMTP for development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=CLASHCODE <no-reply@example.com>

# OAuth (Placeholders)
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub Sync (separate OAuth App with repo scope — can reuse login app if same scopes)
GITHUB_SYNC_CLIENT_ID=replace-with-github-sync-client-id
GITHUB_SYNC_CLIENT_SECRET=replace-with-github-sync-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret-from-github-app-settings

# JWT (Base64 keys for easy dev setup)
# Production should use RS256 and provide both JWT_PRIVATE_KEY and JWT_PUBLIC_KEY.
# Local HS256 only (leave empty when using RS256 keys below)
JWT_SHARED_SECRET=replace-with-long-random-dev-secret
# RS256 (production): PEM contents on one line with \n line breaks.
# Generate with: openssl genpkey -algorithm RSA -out jwt.pem && openssl pkey -in jwt.pem -pubout
# JWT_PRIVATE_KEY=replace-with-pem-private-key
# JWT_PUBLIC_KEY=replace-with-pem-public-key
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
JWT_RETURN_TOKENS_IN_BODY=False

# Optional Cloudinary media hosting
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Payments
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Dashboard -> Webhooks; events: payment.captured, order.paid, payment.failed -> /api/payments/webhook/
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Internal service-to-service auth
INTERNAL_API_KEY=replace-with-long-random-internal-key
INTERNAL_SIGNING_SECRET=replace-with-long-random-signing-secret
INTERNAL_REQUIRE_SIGNATURE=True

# Code execution controls
EXECUTOR_URL=http://executor:8011/execute
# Executor-only credentials (fall back to INTERNAL_* when unset)
EXECUTOR_API_KEY=replace-with-long-random-executor-key
EXECUTOR_SIGNING_SECRET=replace-with-long-random-executor-signing-secret
CODE_EXECUTION_MAX_BYTES=65536
CODE_EXECUTION_TIMEOUT_SECONDS=15
THROTTLE_CODE_EXECUTION_RATE=20/minute
THROTTLE_AI_RATE=10/minute

# Proxies in front of Django (ALB or nginx = 1); used to read the real client IP
NUM_PROXIES=1
USE_X_FORWARDED_HOST=False
# Move Django admin off the default path in production
DJANGO_ADMIN_URL=admin/
MAX_IMAGE_UPLOAD_BYTES=5242880

# Logging / observability
LOG_FORMAT=text
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_PII=false
