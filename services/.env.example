NGINX_HTTP_PORT=80
DB_HOST=replace-with-db-host
DB_PORT=6543
DB_NAME=postgres
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_SSLMODE=require

INTERNAL_REQUIRE_SIGNATURE=true
INTERNAL_SIGNING_SECRET=replace-with-long-random-signing-secret

# Executor-only credentials (must differ from INTERNAL_*; the sandbox never sees anything else)
EXECUTOR_API_KEY=replace-with-long-random-executor-key
EXECUTOR_SIGNING_SECRET=replace-with-long-random-executor-signing-secret

# Redis (private bridge, but require auth anyway)
REDIS_PASSWORD=replace-with-strong-redis-password

# Flower (Celery monitoring) — basic auth, host-bound to 127.0.0.1
FLOWER_BASIC_AUTH=admin:replace-with-strong-flower-password

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90

# Use runsc after installing gVisor on the Docker host. Keep runc for local dev.
CONTAINER_RUNTIME=runc
EXECUTOR_CONTAINER_MEMORY=256m
EXECUTOR_CONTAINER_CPUS=1.0
EXECUTOR_MAX_CODE_BYTES=65536
EXECUTOR_TIMEOUT_SECONDS=5
EXECUTOR_MEMORY_LIMIT_MB=128
EXECUTOR_OUTPUT_LIMIT_BYTES=32768
EXECUTOR_MAX_CONCURRENT_RUNS=4
